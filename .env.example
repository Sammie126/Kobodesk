# sandbox = fake deposit addresses and fake bank payouts (safe for development).
# Any other value refuses to start until you wire real providers in src/providers/index.js.
MODE=sandbox
PORT=3000
DB_PATH=./data/kobodesk.db

# Required outside sandbox. Use long random strings (32+ characters).
TOKEN_SECRET=
WEBHOOK_SECRET=

# Your website's origin, for example https://kobodesk.example. Use * only in development.
CORS_ORIGIN=*

# Comma-separated emails that may use /api/admin routes.
ADMIN_EMAILS=

# Pricing. 150 basis points = 1.5%. These are sample values; set your own.
SPREAD_BPS=150
FLAT_FEE_KOBO=0

# How long a quoted rate and deposit address stay valid.
QUOTE_TTL_SECONDS=900

# Trade limits in kobo (100 kobo = 1 naira). Samples only; set limits that match your compliance rules.
MIN_TRADE_KOBO=100000
MAX_TRADE_KOBO_UNVERIFIED=50000000
MAX_TRADE_KOBO_VERIFIED=5000000000
